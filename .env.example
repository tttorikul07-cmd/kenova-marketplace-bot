# Create a bot with @BotFather and paste the token here. Never share it publicly.
BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
# For local Windows development:
DATABASE_URL=sqlite:///./kenova_shop.db
# Production example (use your own provider credentials):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/kenova
ADMIN_IDS=123456789
SHOP_NAME=KENOVA SHOP
SUPPORT_USERNAME=@KENOVA_Support
MIN_DEPOSIT=20
PAYMENT_BKASH_NUMBER=
PAYMENT_NAGAD_NUMBER=
PAYMENT_ROCKET_NUMBER=
# Required only when using docker-compose PostgreSQL. Replace with a long random secret.
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
